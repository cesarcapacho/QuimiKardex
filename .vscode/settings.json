{
    "tailwindCSS.includeLanguages": {
        "plaintext": "html",
        "javascript": "javascript",
        "javascriptreact": "javascript"
    },
    "css.validate": true,
    "editor.quickSuggestions": {
        "strings": true
    },
    "tailwindCSS.experimental.classRegex": [
        [
            "className\\s*=\\s*\"([^\"]*)",
            1
        ],
        [
            "className\\s*=\\s*`([^`]*)",
            1
        ],
        [
            "className\\s*=\\s*\\{`([^`]*)",
            1
        ],
        [
            "className\\s*=\\s*\\{\\\"([^\\\"]*)",
            1
        ]
    ]
}